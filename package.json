{
  "name": "twi-mon-bot",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "del-cli ./dist",
    "build": "npm run clean && tsc",
    "watch": "tsc -w & cross-env DEBUG=app:* nodemon ./dist/main.js",
    "start": "cross-env DEBUG=app:* node ./dist/main.js",
    "test": "npm run test:types && cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "typescript:check": "tsc --noEmit",
    "prettier": "npx prettier --check ./src",
    "prettier:fix": "npx prettier --write ./src"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.6",
    "html-entities": "^2.3.2",
    "json-stringify-pretty-compact": "^4.0.0",
    "limiter": "^3.0.0",
    "lodash.throttle": "^4.1.1",
    "mariadb": "^3.5.4",
    "node-telegram-bot-api": "^2.1.0",
    "p-limit": "^7.3.2",
    "p-map": "^7.0.7",
    "quick-lru": "^7.3.0",
    "sequelize": "^6.37.8",
    "tough-cookie": "^6.0.2",
    "undici": "^7.29.1",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2",
    "xmldoc": "^3.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node24": "^24.0.5",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.13.3",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@cypress/request": "file:./packages/noop",
    "@cypress/request-promise": "file:./packages/noop"
  }
}
