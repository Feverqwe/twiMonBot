{
  "name": "twi-mon-bot",
  "version": "0.0.1",
  "scripts": {
    "clean": "del-cli ./dist",
    "build": "npm run clean && tsc",
    "watch": "tsc -w & cross-env DEBUG=app:* nodemon ./dist/main.js",
    "start": "cross-env DEBUG=app:* node ./dist/main.js",
    "typescript:check": "tsc --noEmit",
    "prettier": "npx prettier --check ./src",
    "prettier:fix": "npx prettier --write ./src"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.6",
    "html-entities": "^2.3.2",
    "json-stringify-pretty-compact": "^4.0.0",
    "limiter": "^3.0.0",
    "lodash.throttle": "^4.1.1",
    "mariadb": "^3.5.4",
    "node-telegram-bot-api": "^2.1.0",
    "p-limit": "^3.1.0",
    "p-map": "^4.0.0",
    "quick-lru": "^7.3.0",
    "sequelize": "^6.37.8",
    "tough-cookie": "^5.1.0",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2",
    "xmldoc": "^3.0.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.13.3",
    "@types/xmldoc": "^1.1.9",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@cypress/request": "file:./packages/noop",
    "@cypress/request-promise": "file:./packages/noop"
  }
}
